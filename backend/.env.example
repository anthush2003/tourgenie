# Copy this file to .env and fill in your own values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/TourGenie

# Secret used to sign JWTs — use a long, random string in production
JWT_SECRET=change-me-to-a-long-random-string

# OpenRouteService API key (used for route/navigation features)
ORS_API_KEY=

# Number of cluster workers (optional). Leave unset or 1 for a single
# process — the AI chat's in-memory session store assumes sticky sessions
# or CLUSTER_WORKERS=1 unless you swap contextEngine.js to a shared store
# (e.g. Redis) for multi-worker/multi-instance deployments.
# CLUSTER_WORKERS=1

# Google Gemini API key — get one free at https://aistudio.google.com/
# When set, the AI chat uses Gemini 1.5 Flash instead of the built-in rule engine.
GEMINI_API_KEY=

# Credentials used by `npm run seed` to create the initial admin account.
# ALWAYS set these to a strong, unique password before seeding any
# environment that is publicly reachable — do not rely on the fallback
# default, which is documented in this repo and therefore not secret.
SEED_ADMIN_EMAIL=admin@tourgenie.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# CORS — comma-separated list of allowed origins (web app + admin panel)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Free email sending (newsletter confirmations, booking receipts) via Gmail SMTP.
# Setup, no cost:
#   1. Use or create a Gmail account for the app.
#   2. Turn on 2-Step Verification on that account.
#   3. Google Account > Security > 2-Step Verification > App Passwords > generate one.
#   4. Paste the 16-character app password below (not your normal Gmail password).
# If left blank, emails are just logged to the server console instead of sent.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=TourGenie
